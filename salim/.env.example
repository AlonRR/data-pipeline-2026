# --- Object storage (Supabase Storage in prod / MinIO locally) ---
S3_ENDPOINT_URL=http://minio:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=raw-prices
S3_REGION=us-east-1

# --- Queue (CloudAMQP in prod / RabbitMQ locally) ---
RABBITMQ_URL=amqp://guest:guest@rabbitmq:5672/
RABBITMQ_QUEUE=raw-prices

# --- Database (Supabase Postgres in prod / Postgres locally) ---
DATABASE_URL=postgresql+psycopg2://salim:salim@postgres:5432/salim

# --- Crawler ---
CRON_SCHEDULE=0 */6 * * *
CRAWLER_SOURCE_URL=https://example.com/price-files

# --- API ---
API_HOST=0.0.0.0
API_PORT=8000
