# --- Queue ---
RABBITMQ_URL=amqp://guest:guest@rabbitmq:5672/
RABBITMQ_QUEUE=quotes

# --- Database ---
DATABASE_URL=postgresql+psycopg2://quotes:quotes@postgres:5432/quotes

# --- Crawler ---
CRAWLER_SOURCE_URL=https://quotes.toscrape.com
CRAWLER_MAX_PAGES=5

# --- API ---
API_HOST=0.0.0.0
API_PORT=8000
